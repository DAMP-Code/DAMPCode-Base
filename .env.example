# Copie para .env (que não vai para o Git) e preencha.

# Obrigatório: chave do JWT com pelo menos 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Senha do PostgreSQL do container (só vale dentro do docker compose).
POSTGRES_PASSWORD=dampcode

# Porta do navegador: http://localhost:8080
FRONT_PORT=8080

# Onde estão os repositórios clonados (relativo a esta pasta).
API_CONTEXT=../DampCode_API
FRONT_CONTEXT=../Damp-Code-Front

# Nome das imagens. Com "docker compose pull" usa as publicadas pelo CI no GitHub Container Registry.
API_IMAGE=ghcr.io/damp-code/dampcode-api:latest
FRONT_IMAGE=ghcr.io/damp-code/damp-code-front:latest
